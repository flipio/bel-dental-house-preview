# Bel Dental House — Apache / LiteSpeed configuration (generated into dist/.htaccess by scripts/postbuild.mjs).
# Requires mod_rewrite, mod_headers, mod_expires, mod_deflate (standard on cPanel/LiteSpeed shared hosting).
# If the host manages HTTPS redirects itself, delete the HTTPS/hostname block below to avoid double redirects.

Options -Indexes -MultiViews
AddDefaultCharset UTF-8
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Canonical hostname + HTTPS (edit the hostname to match SITE_ORIGIN) -------------------------
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

  # --- Redirects for migrated / retired URLs (from src/data/redirects.json) -----------------------
RewriteRule ^kontakt-beldentalhouse/$ /kontakt/ [R=301,L]
RewriteRule ^kontakt-beldentalhouse$ /kontakt/ [R=301,L]
RewriteRule ^tretmani-dijagnostika/$ /tretmani/dijagnostika/ [R=301,L]
RewriteRule ^zdravo-svete/$ / [R=301,L]

  # --- Trailing-slash policy: directories always end with "/" -----------------------------------
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /$1/ [R=301,L]

  # --- Never serve index.html / .html URLs directly; canonical form is the directory URL ---------
  RewriteCond %{THE_REQUEST} \s/+(.*?)index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]
</IfModule>

# --- Real 404 status for unknown paths (no homepage fallback) ----------------------------------
ErrorDocument 404 /404.html

# --- Compression ---------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/json application/javascript application/rss+xml image/svg+xml font/woff2
</IfModule>

# --- Caching -------------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # HTML: always revalidate so content changes appear immediately after a deploy
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Fingerprinted assets (Astro _astro/ bundles, generated /media/ variants carry a content hash)
  <FilesMatch "\.(css|js|woff2|woff|avif|webp|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Preview build: never indexable (in addition to <meta name="robots" content="noindex"> on every page).
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

# /uploads/ holds mutable source files (an editor may replace a photo under the same name): short cache.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/uploads/#">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </If>
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
